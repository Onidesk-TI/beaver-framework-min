{
    "name": "beaver/framework",
    "version": "0.1.0",
    "description": "Modern PHP framework with a plugin ecosystem.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^7.1",
        "stripe/stripe-php": "^22.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Beaver\\": "src/",
            "Beaver\\Sdk\\": "sdk/src/",
            "Beaver\\Plugins\\HumanCheck\\": "plugins/human-check/src/"
        },
        "files": [
            "app/helpers.php",
            "src/View/helpers.php"
        ]
    },
    "bin": [
        "beaver"
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "beaver": {
            "api_version": "1.0.0"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}